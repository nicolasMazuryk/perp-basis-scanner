{
  "name": "perp-basis-scanner",
  "version": "0.1.0",
  "description": "Real-time terminal scanner ranking perpetual-futures premium and basis across Binance, Bybit, OKX and Bitget over WebSockets",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pix": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "run": "npm start -- --exchanges binance,bybit,okx,bitget",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
